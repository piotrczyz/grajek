# Copy to .secret.local (gitignored) for the local Functions emulator.
# Dummy value: with PUSH_SENDER=log the emulator never sends a real push.
# For real sends from the emulator, put your own private key here
# (pnpm --dir functions exec web-push generate-vapid-keys).
VAPID_PRIVATE_KEY=dummy-private-key-for-the-emulator-only
